ANTHROPIC_BASE_URL=https://api.moonshot.ai/anthropic
ANTHROPIC_AUTH_TOKEN=
ANTHROPIC_MODEL=kimi-k2.5
# Optional OpenAI provider. If only OPENAI_API_KEY is set, Tritree uses OpenAI automatically.
# TRITREE_AI_PROVIDER=openai
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-5.5
# OPENAI_API_MODE=responses
# OPENAI_BASE_URL=https://api.openai.com/v1
TRITREE_DB_PATH=.tritree/tritree.sqlite
# Optional: set a MySQL URL to use MySQL instead of SQLite.
# TRITREE_DATABASE_URL=mysql://user:password@localhost:3306/tritree
TRITREE_SKILL_EXECUTION_MODE=auto
# TRITREE_DEFAULTS_CONFIG_PATH=/absolute/path/to/defaults.json
# TRITREE_ARTIFACT_TYPES=all
# TRITREE_PUBLISH_PLATFORMS=weibo,xiaohongshu,moments
# TRITREE_INSPIRATION_URL=https://your-provider.example/inspirations
# TRITREE_INSPIRATION_TOKEN=
# TRITREE_WEB_BASE_PATH=/tritree
# TRITREE_APP_ROOT_PATH=/chat
# TRITREE_MCP_CONFIG_PATH=/absolute/path/to/mcp.json
